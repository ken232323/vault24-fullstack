# Copy to .env (never commit .env). All values optional; defaults are the secure choice.
APP_ENV=development            # production | development | testing  (seed.php refuses to run in production)
DB_PATH=storage/vault24.sqlite
LOG_PATH=storage/logs/app.log
# Origins of the React apps (customer :5173, admin :5174). Needed for the browser Origin/CSRF check and CORS.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
TRUSTED_PROXIES=               # comma-separated proxy IPs allowed to set X-Forwarded-For
COOKIE_SECURE=false            # true behind HTTPS: adds the Secure flag to session cookies
ENABLE_HSTS=false              # true when served over HTTPS
SESSION_IDLE_SECONDS=900
SESSION_ABSOLUTE_SECONDS=28800
MAX_TRANSFER_MINOR=1000000     # 10,000.00 simulated
